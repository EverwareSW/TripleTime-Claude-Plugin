      "url": "${TRIPLETIME_URL:-https://api.tripletime.app}/mcp",
      "headersHelper": "[ -z \"$TRIPLETIME_TOKEN\" ] && source '${CLAUDE_PLUGIN_DATA}/.env' 2>/dev/null; printf '{\"Authorization\":\"Bearer %s\"}' \"$TRIPLETIME_TOKEN\""
    }
  }
}